---
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

const workEntries = await getCollection('work');
const resolved = workEntries
  .map((entry) => {
    const data = entry.data;
    const dateValue = data.date instanceof Date ? data.date : new Date(data.date);
    let thumbnail = data.thumbnail;
    if (!thumbnail) {
      try {
        const dir = path.join(process.cwd(), 'public', 'assets', 'work', entry.slug);
        if (fs.existsSync(dir)) {
          const files = fs
            .readdirSync(dir)
            .filter((file) => /\.(png|jpe?g|webp|gif|avif)$/i.test(file))
            .sort((a, b) => a.localeCompare(b, 'en', { numeric: true }));
          thumbnail = files[0] ? `/assets/work/${entry.slug}/${files[0]}` : undefined;
        } else {
          thumbnail = undefined;
        }
      } catch (error) {
        thumbnail = undefined;
      }
    }
    return {
      slug: entry.slug,
      title: data.title,
      brand: data.brand,
      event: data.event,
      date: dateValue,
      dateLabel: new Intl.DateTimeFormat('en-MY', { month: 'short', day: 'numeric', year: 'numeric' }).format(dateValue),
      thumbnail,
    };
  })
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 10);
---
<section id="work" class="section-shell work-carousel">
  <header>
    <h2>Our latest work</h2>
    <p>Recent activations and builds launched across Malaysia.</p>
  </header>
  <div class="carousel" role="list">
    {resolved.map((item) => (
      <a class="glass work-card focus-ring" href={`/work#${item.slug}`} role="listitem">
        {item.thumbnail && (
          <img src={item.thumbnail} alt={`Preview of ${item.title}`} loading="lazy" />
        )}
        <div class="meta">
          <h3>{item.title}</h3>
          <p>{item.brand} · {item.event}</p>
          <time dateTime={item.date.toISOString()}>{item.dateLabel}</time>
        </div>
      </a>
    ))}
    <a class="glass work-card more focus-ring" href="/work">
      <div class="meta">
        <h3>View all work</h3>
        <p>See the full archive of builds and campaigns.</p>
      </div>
    </a>
  </div>
</section>

<style>
  .work-carousel {
    gap: var(--spacing-xl);
  }

  .carousel {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(260px, 320px);
    gap: var(--spacing-lg);
    overflow-x: auto;
    padding-bottom: var(--spacing-sm);
    scroll-snap-type: x mandatory;
  }

  .carousel::-webkit-scrollbar {
    height: 0.4rem;
  }

  .carousel::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-pill);
  }

  .work-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    padding: var(--spacing-md);
    min-height: 320px;
    scroll-snap-align: start;
  }

  .work-card img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    border-radius: calc(var(--radius-lg) - 12px);
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .meta h3 {
    margin: 0;
    font-size: var(--text-lg);
  }

  .meta p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  time {
    color: var(--color-text);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
  }

  .work-card.more {
    justify-content: center;
    align-items: flex-start;
  }

  .work-card.more::after {
    content: '→';
    font-size: 2rem;
    position: absolute;
    bottom: var(--spacing-md);
    right: var(--spacing-md);
    color: var(--color-accent-teal);
  }

  @media (max-width: 640px) {
    .carousel {
      grid-auto-columns: 80%;
    }
  }
</style>
