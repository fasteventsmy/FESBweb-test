---
const heroImage = new URL('../../assets/hero/hero-main.jpg', import.meta.url).href;

const headline = 'Design. Build. Go live.';
const subline =
  'Pop-ups, roadshows, and brand activations with creative speed and technical calm.';
---
<section id="hero" class="hero">
  {heroImage && (
    <div class="hero__background" aria-hidden="true">
      <img
        src={heroImage}
        alt=""
        loading="eager"
        decoding="async"
        fetchpriority="high"
        class="hero__background-img"
      />
    </div>
  )}
  <div class="hero__content">
    <img
      src="/assets/brands/Fast Events white SVG.svg"
      alt="FAST Events"
      class="hero__logo"
      width="184"
      height="56"
      loading="eager"
    />
    <h1>{headline}</h1>
    <p class="hero__subhead">{subline}</p>
    <div class="hero__actions">
      <a class="hero__cta hero__cta--primary focus-ring" href="#services">What we do</a>
      <a class="hero__cta hero__cta--secondary focus-ring" href="#work">Our work</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 100vh;
    padding: clamp(120px, 16vh, 180px) var(--spacing-lg);
    overflow: hidden;
    background-color: #0a0a0a;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: clamp(180px, 32vh, 320px);
    background: linear-gradient(180deg, rgba(10, 10, 10, 0) 0%, #0a0a0a 46.154%);
    pointer-events: none;
  }

  .hero__background {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background-color: #0a0a0a;
  }

  .hero__background-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  .hero__content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(18px, 3vw, 28px);
    max-width: min(720px, 90vw);
    color: var(--text);
    z-index: 1;
  }

  .hero__logo {
    width: clamp(140px, 18vw, 220px);
    height: auto;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 1.7rem + 2vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .hero__subhead {
    margin: 0;
    font-size: clamp(1.15rem, 1rem + 0.8vw, 1.5rem);
    font-weight: 500;
    color: rgba(255, 255, 255, 0.88);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(12px, 3vw, 16px);
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 55px;
    padding: 0 clamp(20px, 4vw, 22px);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: clamp(0.95rem, 0.9rem + 0.3vw, 1.05rem);
    letter-spacing: 0.015em;
    text-decoration: none;
    transition: transform 150ms ease, box-shadow 150ms ease, color 150ms ease, background 150ms ease,
      border-color 150ms ease;
    border: 1px solid transparent;
    box-shadow: 0 0 0 rgba(0, 0, 0, 0);
  }

  .hero__cta:hover,
  .hero__cta:focus-visible {
    transform: translateY(-1px);
    color: #ffffff;
  }

  .hero__cta--primary {
    color: #ffffff;
    background:
      linear-gradient(145deg, rgba(255, 44, 157, 0.96), rgba(255, 44, 157, 0.72)),
      radial-gradient(160% 200% at 50% -50%, rgba(255, 255, 255, 0.35), transparent 55%);
    box-shadow:
      0 10px 24px rgba(255, 44, 157, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.4),
      inset 0 -1px 0 rgba(0, 0, 0, 0.28);
  }

  .hero__cta--primary:hover,
  .hero__cta--primary:focus-visible {
    box-shadow:
      0 16px 32px rgba(255, 44, 157, 0.36),
      inset 0 1px 0 rgba(255, 255, 255, 0.5),
      inset 0 -1px 0 rgba(0, 0, 0, 0.32);
  }

  .hero__cta--secondary {
    color: rgba(255, 255, 255, 0.9);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0.12));
    border-color: var(--glass-border);
    box-shadow:
      var(--glass-shadow),
      inset 0 1px 0 var(--glass-inner),
      inset 0 -1px 0 rgba(0, 0, 0, 0.18);
  }

  .hero__cta--secondary:hover,
  .hero__cta--secondary:focus-visible {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0.16));
    border-color: rgba(255, 255, 255, 0.48);
  }

  @media (max-width: 900px) {
    .hero {
      padding: clamp(110px, 18vh, 150px) var(--spacing-md) clamp(80px, 14vh, 140px);
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 80vh;
      padding: clamp(96px, 12vh, 130px) var(--spacing-md) clamp(72px, 12vh, 120px);
    }

    .hero__cta {
      height: 48px;
      padding: 0 clamp(16px, 5vw, 18px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__cta {
      transition: none;
    }

    .hero__cta:hover,
    .hero__cta:focus-visible {
      transform: none;
    }
  }
</style>
