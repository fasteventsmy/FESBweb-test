---
import { readdirSync, statSync } from 'fs';

let heroConfig: { image?: string; headline?: string; subline?: string } | undefined;
try {
  heroConfig = (await import('../../data/hero.json')).default;
} catch (error) {
  heroConfig = undefined;
}

const heroDir = new URL('../../../public/assets/hero', import.meta.url);
let fallbackImage = '';
try {
  const files = readdirSync(heroDir)
    .filter((file) => /\.(jpe?g|png|webp|avif)$/i.test(file))
    .map((file) => {
      const stats = statSync(new URL(file, heroDir));
      return { file, time: stats.mtime.getTime() };
    })
    .sort((a, b) => b.time - a.time);
  fallbackImage = files[0] ? `/assets/hero/${files[0].file}` : '';
} catch (error) {
  fallbackImage = '';
}

const backgroundImage = heroConfig?.image ?? fallbackImage;
const headline = heroConfig?.headline ?? 'Design. Build. Go live.';
const subline = heroConfig?.subline ??
  'Pop-ups, roadshows, and brand activations with creative speed and technical calm.';
---
<section id="hero" class="section-shell hero">
  <div class="hero-content glass">
    <div class="copy">
      <p class="eyebrow">FAST Events</p>
      <h1>{headline}</h1>
      <p class="lead">{subline}</p>
      <div class="actions">
        <a class="btn" href="#services">What we do</a>
        <a class="btn secondary" href="#work">Our work</a>
      </div>
    </div>
  </div>
  {backgroundImage && (
    <figure class="hero-visual">
      <img src={backgroundImage} alt="Experiential activation hero" loading="lazy" />
      <div class="glow" aria-hidden="true"></div>
    </figure>
  )}
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--spacing-xl);
    align-items: center;
    margin-top: var(--spacing-2xl);
  }

  .hero-content {
    padding: var(--spacing-xl);
    position: relative;
    overflow: hidden;
  }

  .hero-content::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at top left, rgba(255, 44, 157, 0.18), transparent 60%);
    opacity: 0.7;
    pointer-events: none;
  }

  .copy {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .eyebrow {
    margin: 0;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  h1 {
    font-size: clamp(2.8rem, 2.2rem + 2vw, 4rem);
    line-height: 1.05;
    margin: 0;
  }

  .lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-md);
  }

  .hero-visual {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    min-height: 320px;
    max-height: 560px;
  }

  .hero-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(1.05);
  }

  .hero-visual .glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 60%, rgba(255, 44, 157, 0.35), transparent 65%);
    mix-blend-mode: screen;
  }

  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero-content {
      padding: var(--spacing-lg);
    }
  }
</style>
