---
import fs from 'node:fs';
import path from 'node:path';
import LogoMarquee from '../ui/LogoMarquee.astro';

const logoDir = path.join(process.cwd(), 'public', 'assets', 'brands');
const logos = (fs.existsSync(logoDir)
  ? fs.readdirSync(logoDir).filter((file) => /\.(png|jpe?g|webp|gif|avif|svg)$/i.test(file))
  : [])
  .sort((a, b) => a.localeCompare(b, 'en'))
  .map((file) => `/assets/brands/${file}`);
---
<section class="section-shell brands-strip">
  <header>
    <h2>Brands that call us first</h2>
    <p>Collaborations with tech, lifestyle, and FMCG teams.</p>
  </header>
  <LogoMarquee items={logos.map((logo) => ({ src: logo }))} />
</section>

<style>
  .brands-strip {
    gap: var(--spacing-lg);
  }
</style>
