---
import imgA from "../assets/why-brands/436ec9309c385244b1e7e529bb712b27.jpg";
import imgB from "../assets/why-brands/750f2045ac71af188cfdb8fe101dd8ad.jpg";

const media = [imgA, imgB];
---

<section id="why-brands" class="wb-shell why-brands section-shell wb-section" aria-labelledby="wb-title">
  <div class="section-head center">
    <h2 id="wb-title" class="wb-title">Why Brands Choose FAST</h2>
    <p class="wb-sub">Production, creative, and ops aligned so your show runs clean.</p>
  </div>

  <div class="wb-wrap why-grid">
    <!-- MEDIA COLUMN -->
    <figure class="wb-media why-media">
      <div class="wb-frame" tabindex="0" aria-label="Event media showcase">
        <img src={media[0].src} alt="FAST showcase 1" class="wb-img wb-img--active why-media-img" />
        <img src={media[1].src} alt="FAST showcase 2" class="wb-img why-media-img" />
        <button class="wb-hit wb-hit--prev" aria-label="Previous"></button>
        <button class="wb-hit wb-hit--next" aria-label="Next"></button>
      </div>
      <figcaption class="sr-only">Auto-rotating showcase; click left for previous, right for next.</figcaption>
    </figure>

    <!-- CARDS GRID -->
    <div class="wb-grid why-stack">
      <article class="feature-card glass wb-card">
        <div class="feature-icon wb-icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="44"
            height="44"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 20h9" />
            <path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4Z" />
          </svg>
        </div>
        <div class="feature-body wb-body">
          <h3 class="feature-title">Creative Agility</h3>
          <p class="feature-desc">Ideas fast, on brand, ready to build and approve.</p>
        </div>
      </article>

      <article class="feature-card glass wb-card">
        <div class="feature-icon wb-icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="44"
            height="44"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="3" width="7" height="7" />
            <rect x="14" y="3" width="7" height="7" />
            <rect x="14" y="14" width="7" height="7" />
            <rect x="3" y="14" width="7" height="7" />
          </svg>
        </div>
        <div class="feature-body wb-body">
          <h3 class="feature-title">Technical Precision</h3>
          <p class="feature-desc">CAD, load, power, and rigging sorted before you hit site.</p>
        </div>
      </article>

      <article class="feature-card glass wb-card">
        <div class="feature-icon wb-icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="44"
            height="44"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 3" />
          </svg>
        </div>
        <div class="feature-body wb-body">
          <h3 class="feature-title">Last-Minute Rescue</h3>
          <p class="feature-desc">Late brief, new VIP, weather shift. We turn it around today.</p>
        </div>
      </article>

      <article class="feature-card glass wb-card">
        <div class="feature-icon wb-icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="44"
            height="44"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="2" y="3" width="20" height="14" rx="2" />
            <path d="M8 21h8" />
          </svg>
        </div>
        <div class="feature-body wb-body">
          <h3 class="feature-title">Live Ops Control</h3>
          <p class="feature-desc">Showcaller, comms, and run-of-show locked to the minute.</p>
        </div>
      </article>

      <article class="feature-card glass wb-card">
        <div class="feature-icon wb-icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="44"
            height="44"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M3 3h7v7H3z" />
            <path d="M14 3h7v7h-7z" />
            <path d="M14 14h7v7h-7z" />
            <path d="M3 14h7v7H3z" />
          </svg>
        </div>
        <div class="feature-body wb-body">
          <h3 class="feature-title">Modular and Scalable</h3>
          <p class="feature-desc">Kits that snap together for malls, roadshows, expos, and tours.</p>
        </div>
      </article>

      <article class="feature-card glass wb-card">
        <div class="feature-icon wb-icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="44"
            height="44"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
          </svg>
        </div>
        <div class="feature-body wb-body">
          <h3 class="feature-title">Safe and Compliant</h3>
          <p class="feature-desc">Permits, HSE, risk, and crew briefed and audited.</p>
        </div>
      </article>
    </div>
  </div>

  <script is:inline>
    (() => {
      const root = document.currentScript.closest('.wb-shell');
      const frame = root.querySelector('.wb-frame');
      const imgs  = [...root.querySelectorAll('.wb-img')];
      const prev  = root.querySelector('.wb-hit--prev');
      const next  = root.querySelector('.wb-hit--next');

      let i = 0, t = 0;
      const show = (n) => {
        i = (n + imgs.length) % imgs.length;
        imgs.forEach((el, idx) => el.classList.toggle('wb-img--active', idx === i));
      };
      const stepNext = () => show(i + 1);
      const stepPrev = () => show(i - 1);

      const stop  = () => { clearInterval(t); t = 0; };
      const start = () => {
        if (t) return;
        t = setInterval(stepNext, 5000);
      };

      prev.addEventListener('click', stepPrev);
      next.addEventListener('click', stepNext);
      frame.addEventListener('mouseenter', stop);
      frame.addEventListener('mouseleave', start);
      frame.addEventListener('focusin', stop);
      frame.addEventListener('focusout', start);
      frame.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') stepNext();
        if (e.key === 'ArrowLeft')  stepPrev();
      });

      start();
    })();
  </script>
</section>
