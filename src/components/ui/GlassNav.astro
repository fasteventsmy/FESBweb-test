<style>
  .nav-wrap {
    position: sticky;
    top: 14px;
    z-index: 50;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 10px 14px;
    width: min(1000px, calc(100% - 24px));
    backdrop-filter: blur(14px) saturate(120%);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0.12));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-xl);
    box-shadow:
      var(--glass-shadow),
      inset 0 1px 0 var(--glass-inner),
      inset 0 -1px 0 rgba(0, 0, 0, 0.18);
  }

  .brand {
    display: inline-flex;
    align-items: center;
  }

  .brand img {
    height: 22px;
    width: auto;
    display: block;
  }

  .nav-list {
    display: flex;
    gap: 6px;
    align-items: center;
    margin-left: auto;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .nav-links-mobile {
    display: none;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    gap: 4px;
  }

  .nav-links-mobile .nav-link,
  .nav-links-mobile .mobile-link {
    justify-content: flex-start;
  }

  .nav-link,
  .mobile-link {
    color: var(--muted);
    text-decoration: none;
    font-weight: 600;
    letter-spacing: 0.2px;
    padding: 10px 16px;
    border-radius: 999px;
    position: relative;
    transition: transform 0.16s ease, background 0.16s ease, color 0.16s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .nav-link:hover,
  .mobile-link:hover {
    color: #fff;
    transform: translateY(-1px);
  }

  .nav-link:focus-visible,
  .mobile-link:focus-visible {
    color: #fff;
  }

  .nav-link.is-active,
  .mobile-link.is-active {
    color: #fff;
    background:
      linear-gradient(145deg, rgba(255, 44, 157, 0.95), rgba(255, 44, 157, 0.7)),
      radial-gradient(120% 180% at 50% -40%, rgba(255, 255, 255, 0.35), transparent 55%);
    box-shadow:
      0 8px 22px rgba(255, 44, 157, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.35),
      inset 0 -1px 0 rgba(0, 0, 0, 0.25);
  }

  .hamburger {
    display: none;
    color: #fff;
    background: transparent;
    border: 0;
    font-size: 18px;
    padding: 8px 12px;
    border-radius: 8px;
    cursor: pointer;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 820px) {
    .hamburger {
      display: block;
    }

    .nav-wrap {
      width: calc(100% - 24px);
    }

    .nav-list {
      position: fixed;
      left: 12px;
      right: 12px;
      top: 68px;
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.1));
      backdrop-filter: blur(14px) saturate(120%);
      border: 1px solid var(--glass-border);
      border-radius: 16px;
      padding: 10px;
      display: none;
      flex-direction: column;
      gap: 4px;
      box-shadow:
        var(--glass-shadow),
        inset 0 1px 0 var(--glass-inner),
        inset 0 -1px 0 rgba(0, 0, 0, 0.18);
    }

    .nav-list.open {
      display: flex;
    }

    .nav-links-desktop {
      display: none;
    }

    .nav-links-mobile {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      gap: 4px;
    }

    .nav-links-mobile .nav-link,
    .nav-links-mobile .mobile-link {
      width: 100%;
    }
  }
</style>

<nav class="nav-wrap" aria-label="Primary navigation">
  <a href="/" class="brand" aria-label="FAST Events — Home">
    <img src="/assets/brands/Fast Events white SVG.svg" alt="FAST Events" />
  </a>
  <button class="hamburger focus-ring" type="button" aria-expanded="false" aria-controls="primary-nav">
    <span class="sr-only">Toggle navigation</span>
    <span aria-hidden="true">☰</span>
  </button>
  <div class="nav-list" id="primary-nav">
    <div class="nav-links nav-links-desktop">
      <slot name="links" />
    </div>
    <div class="nav-links nav-links-mobile">
      <slot name="mobile-links" />
    </div>
  </div>
</nav>

<script client:load>
  const navLinks = Array.from(document.querySelectorAll('[data-glass-nav-link]'));
  const mobileLinks = Array.from(document.querySelectorAll('[data-glass-nav-mobile-link]'));
  const toggle = document.querySelector('.hamburger');
  const navList = document.querySelector('.nav-list');
  const homeSectionsAttr = document.body.dataset.homeSections;
  const isHome = Boolean(homeSectionsAttr);
  const mobileQuery = window.matchMedia?.('(max-width: 820px)');
  let activeAnchor = null;

  const closeSheet = () => {
    toggle?.setAttribute('aria-expanded', 'false');
    navList?.classList.remove('open');
  };

  const focusFirstLink = () => {
    const firstLink = navList?.querySelector('[data-glass-nav-mobile-link]') ??
      navList?.querySelector('[data-glass-nav-link]');
    if (firstLink instanceof HTMLElement) {
      firstLink.focus();
    }
  };

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    if (expanded) {
      closeSheet();
    } else {
      toggle.setAttribute('aria-expanded', 'true');
      navList?.classList.add('open');
      if (mobileQuery?.matches) {
        focusFirstLink();
      }
    }
  });

  navList?.addEventListener('click', (event) => {
    if (event.target instanceof HTMLAnchorElement && mobileQuery?.matches) {
      closeSheet();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && navList?.classList.contains('open')) {
      closeSheet();
      toggle?.focus();
    }
  });

  const handleMobileChange = (event) => {
    if (!event.matches) {
      closeSheet();
    }
  };

  mobileQuery?.addEventListener?.('change', handleMobileChange);
  mobileQuery?.addListener?.(handleMobileChange);

  const setActive = (href) => {
    if (activeAnchor === href) return;
    activeAnchor = href;
    navLinks.forEach((link) => {
      if (!(link instanceof HTMLElement)) return;
      link.classList.toggle('is-active', link.dataset.glassNavLink === href);
    });
    mobileLinks.forEach((link) => {
      if (!(link instanceof HTMLElement)) return;
      link.classList.toggle('is-active', link.dataset.glassNavMobileLink === href);
    });
  };

  const normalizeHref = (value = '') => {
    try {
      const url = new URL(value, window.location.origin);
      return url.pathname + url.hash;
    } catch (error) {
      return value;
    }
  };

  const currentPath = window.location.pathname;
  setActive(currentPath + window.location.hash);

  navLinks.forEach((link) => {
    link.addEventListener('click', () => setActive(normalizeHref(link.getAttribute('href') ?? '')));
  });

  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => {
      setActive(normalizeHref(link.getAttribute('href') ?? ''));
      closeSheet();
    });
  });

  if (!('matchMedia' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.style.scrollBehavior = 'auto';
  }

  if (isHome && 'IntersectionObserver' in window) {
    const ids = homeSectionsAttr.split(',');
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible) return;
        if (visible.target.id === 'hero') {
          setActive('/');
        } else {
          setActive('/#' + visible.target.id);
        }
      },
      {
        threshold: [0.35, 0.6],
        rootMargin: '-20% 0px -55% 0px',
      }
    );

    ids.forEach((id) => {
      const el = document.getElementById(id);
      if (el) {
        observer.observe(el);
      }
    });
  }
</script>
