---
const path = Astro.url.pathname;
const isHome = path === '/';

const servicesHref = isHome ? '#services' : '/services';
const servicesData = isHome ? '/#services' : '/services';
const workHref = isHome ? '#work' : '/work';
const workData = isHome ? '/#work' : '/work';
const contactHref = isHome ? '#contact' : '/contact';
const contactData = isHome ? '/#contact' : '/contact';
---

<style>
.nav-wrap{
  position: sticky; top: 14px; z-index: 50;
  margin-inline:auto;
  display:flex; align-items:center; justify-content:space-between;
  gap:18px;
  padding:12px 18px;                 /* outer padding */
  width: min(1000px, calc(100% - 24px));
  min-height: 75px;                  /* thinner desktop bar */
  backdrop-filter: blur(14px) saturate(120%);
  background: linear-gradient(180deg, rgba(255,255,255,.22), rgba(255,255,255,.12));
  border: 1px solid var(--glass-border);
  border-radius: 999px;
  box-shadow:
    var(--glass-shadow),
    inset 0 1px 0 var(--glass-inner),
    inset 0 -1px 0 rgba(0,0,0,.18);
}

/* logo */
.brand{
  display:flex; align-items:center; justify-content:center;
  height:51px;
  padding:0 20px;
  border-radius:999px;
}
.brand img{ height:42px; width:auto; display:block; }

/* menu */
.nav-list{ display:flex; align-items:center; gap:14px; margin-left:auto; }

/* chips ~55px tall */
.nav-link{
  display:flex; align-items:center; justify-content:center;
  height:51px;                       /* target chip height */
  padding:0 18px;                    /* inner horizontal */
  border-radius:999px;
  text-decoration:none; font-weight:700;
  letter-spacing:.2px;
  color: var(--muted);
  transition: transform .16s ease, background .16s ease, color .16s ease, box-shadow .16s ease;
}
.nav-link:hover{ color:#fff; transform: translateY(-1px); }

/* ACTIVE magenta liquid glass */
.nav-link.is-active{
  color:#fff;
  background:
    linear-gradient(145deg, rgba(255,44,157,.96), rgba(255,44,157,.72)),
    radial-gradient(160% 200% at 50% -50%, rgba(255,255,255,.35), transparent 55%);
  box-shadow:
    0 10px 24px rgba(255,44,157,.28),
    inset 0 1px 0 rgba(255,255,255,.40),
    inset 0 -1px 0 rgba(0,0,0,.28);
}

/* Mobile */
.hamburger{ display:none; color:#fff; background:transparent; border:0; font-size:32px; padding:8px 12px; border-radius:8px}
@media (max-width: 820px){
  .hamburger{ display:block }
  .nav-wrap{ width: calc(100% - 24px); min-height:70px; padding:10px 12px; }
  .nav-list{
    position: fixed; left:12px; right:12px; top:68px;
    background: linear-gradient(180deg, rgba(255,255,255,.20), rgba(255,255,255,.10));
    backdrop-filter: blur(14px) saturate(120%);
    border: 1px solid var(--glass-border); border-radius:16px; padding:10px;
    display:none; flex-direction:column; gap:8px;
    box-shadow:
      var(--glass-shadow),
      inset 0 1px 0 var(--glass-inner),
      inset 0 -1px 0 rgba(0,0,0,.18);
  }
  .nav-list.open{ display:flex }
  .nav-link{ height:48px; padding:0 16px; }
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}
</style>

<nav class="nav-wrap" aria-label="Primary navigation">
  <a href="/" class="brand" aria-label="FAST Events — Home">
    <img src="/assets/brands/Fast Events white SVG.svg" alt="FAST Events" />
  </a>
  <button class="hamburger focus-ring" type="button" aria-expanded="false" aria-controls="primary-nav">
    <span class="sr-only">Toggle navigation</span>
    <span aria-hidden="true">☰</span>
  </button>
  <div class="nav-list" id="primary-nav">
    <a
      href="/"
      class={`nav-link focus-ring ${path === '/' ? 'is-active' : ''}`}
      data-glass-nav-link="/"
    >Home</a>
    <a
      href="/about"
      class={`nav-link focus-ring ${path.startsWith('/about') ? 'is-active' : ''}`}
      data-glass-nav-link="/about"
    >About</a>
    <a
      href={servicesHref}
      class={`nav-link focus-ring ${path.startsWith('/services') ? 'is-active' : ''}`}
      data-glass-nav-link={servicesData}
    >Our Services</a>
    <a
      href={workHref}
      class={`nav-link focus-ring ${path.startsWith('/work') ? 'is-active' : ''}`}
      data-glass-nav-link={workData}
    >Our Work</a>
    <a
      href={contactHref}
      class={`nav-link focus-ring ${path.startsWith('/contact') ? 'is-active' : ''}`}
      data-glass-nav-link={contactData}
    >Contact</a>
  </div>
</nav>

<script client:load>
  const navLinks = Array.from(document.querySelectorAll('[data-glass-nav-link]'));
  const toggle = document.querySelector('.hamburger');
  const navList = document.querySelector('.nav-list');
  const homeSectionsAttr = document.body.dataset.homeSections;
  const isHome = Boolean(homeSectionsAttr);
  const mobileQuery = window.matchMedia?.('(max-width: 820px)');
  let activeAnchor = null;

  const closeSheet = () => {
    toggle?.setAttribute('aria-expanded', 'false');
    navList?.classList.remove('open');
  };

  const focusFirstLink = () => {
    const [firstLink] = navLinks;
    if (firstLink instanceof HTMLElement) {
      firstLink.focus();
    }
  };

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    if (expanded) {
      closeSheet();
    } else {
      toggle.setAttribute('aria-expanded', 'true');
      navList?.classList.add('open');
      if (mobileQuery?.matches) {
        focusFirstLink();
      }
    }
  });

  navList?.addEventListener('click', (event) => {
    if (event.target instanceof HTMLAnchorElement && mobileQuery?.matches) {
      closeSheet();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && navList?.classList.contains('open')) {
      closeSheet();
      toggle?.focus();
    }
  });

  const handleMobileChange = (event) => {
    if (!event.matches) {
      closeSheet();
    }
  };

  mobileQuery?.addEventListener?.('change', handleMobileChange);
  mobileQuery?.addListener?.(handleMobileChange);

  const setActive = (href) => {
    if (activeAnchor === href) return;
    activeAnchor = href;
    navLinks.forEach((link) => {
      if (!(link instanceof HTMLElement)) return;
      link.classList.toggle('is-active', link.dataset.glassNavLink === href);
    });
  };

  const normalizeHref = (value = '') => {
    try {
      const url = new URL(value, window.location.origin);
      return url.pathname + url.hash;
    } catch (error) {
      return value;
    }
  };

  const currentPath = window.location.pathname;
  setActive(currentPath + window.location.hash);

  navLinks.forEach((link) => {
    link.addEventListener('click', () => setActive(normalizeHref(link.getAttribute('href') ?? '')));
  });

  if (!('matchMedia' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.style.scrollBehavior = 'auto';
  }

  if (isHome && 'IntersectionObserver' in window) {
    const ids = homeSectionsAttr.split(',');
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible) return;
        if (visible.target.id === 'hero') {
          setActive('/');
        } else {
          setActive('/#' + visible.target.id);
        }
      },
      {
        threshold: [0.35, 0.6],
        rootMargin: '-20% 0px -55% 0px',
      }
    );

    ids.forEach((id) => {
      const el = document.getElementById(id);
      if (el) {
        observer.observe(el);
      }
    });
  }
</script>
