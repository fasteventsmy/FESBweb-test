---
const mods = import.meta.glob('../assets/why-brands/*.{jpg,jpeg,png,webp,svg}', {
  eager: true,
  import: 'default',
});

const images = Object.entries(mods)
  .map(([path, src]) => ({ path, src: String(src) }))
  .sort((a, b) => a.path.localeCompare(b.path))
  .map(({ src }) => src);

const title = 'Why Brands Choose FAST';
const subtitle = 'Production, creative, and ops aligned so your show runs clean.';
---

<section id="why-brands" class="why-brands">
  <div class="wb-container">
    <header class="wb-head">
      <h2 class="wb-title">{title}</h2>
      <p class="wb-sub">{subtitle}</p>
    </header>

    <div class="wb-grid">
      <div class="wb-media glass-silver" aria-label="FAST show visual">
        <div class="wb-slider">
          {images.map((src, idx) => (
            <img src={src} alt={`FAST showcase ${idx + 1}`} class="wb-slide" data-index={idx} loading="lazy" decoding="async" />
          ))}
        </div>
      </div>

      <div class="wb-cards">
        <article class="wb-card whyfast-card glass-silver hover-magenta">
          <div class="card-icon">✎</div>
          <h3 class="card-title">Creative Agility</h3>
          <p class="card-copy">Ideas fast, on brand, ready to build and approve.</p>
        </article>

        <article class="wb-card whyfast-card glass-silver hover-magenta">
          <div class="card-icon">▦</div>
          <h3 class="card-title">Technical Precision</h3>
          <p class="card-copy">CAD, load, power, and rigging sorted before you hit site.</p>
        </article>

        <article class="wb-card whyfast-card glass-silver hover-magenta">
          <div class="card-icon">◷</div>
          <h3 class="card-title">Last-Minute Rescue</h3>
          <p class="card-copy">Late brief, new VIP, weather shift. We turn it around today.</p>
        </article>

        <article class="wb-card whyfast-card glass-silver hover-magenta">
          <div class="card-icon">▣</div>
          <h3 class="card-title">Live Ops Control</h3>
          <p class="card-copy">Showcaller, comms, and run-of-show locked to the minute.</p>
        </article>

        <article class="wb-card whyfast-card glass-silver hover-magenta">
          <div class="card-icon">⌗</div>
          <h3 class="card-title">Modular and Scalable</h3>
          <p class="card-copy">Kits for malls, roadshows, expos, and tours.</p>
        </article>

        <article class="wb-card whyfast-card glass-silver hover-magenta">
          <div class="card-icon">🛡</div>
          <h3 class="card-title">Safe and Compliant</h3>
          <p class="card-copy">Permits, HSE, risk, and crew briefed and audited.</p>
        </article>
      </div>
    </div>
  </div>

  <script is:inline>
    const slides = Array.from(document.querySelectorAll('#why-brands .wb-slide'));

    if (slides.length) {
      let index = 0;

      const show = (nextIndex) => {
        slides.forEach((el, idx) => {
          const isActive = idx === nextIndex;
          el.style.opacity = isActive ? '1' : '0';
          el.style.zIndex = isActive ? '2' : '1';
        });
      };

      show(index);

      if (slides.length > 1) {
        setInterval(() => {
          index = (index + 1) % slides.length;
          show(index);
        }, 5000);
      }
    }
  </script>
</section>

<style>
  :root {
    --wb-container-px: clamp(16px, 3vw, 28px);
    --wb-gap: clamp(20px, 3.2vw, 32px);
  }

  .why-brands {
    padding: clamp(40px, 6vw, 96px) 0;
  }

  .wb-container {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: var(--wb-container-px);
  }

  .wb-head {
    text-align: center;
    margin-bottom: clamp(24px, 4vw, 40px);
  }

  .wb-title {
    font-size: clamp(28px, 4.2vw, 48px);
    line-height: 1.1;
    color: #e8e8ea;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .wb-sub {
    margin-top: 0.5rem;
    color: rgba(233, 235, 240, 0.8);
    font-size: clamp(14px, 2.2vw, 16px);
  }

  .wb-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--wb-gap);
  }

  .wb-media {
    border-radius: 24px;
    overflow: hidden;
    position: relative;
  }

  .wb-slider {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
  }

  .wb-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.6s ease;
    opacity: 0;
  }

  .wb-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--wb-gap);
  }

  .wb-card {
    border-radius: 20px;
    padding: clamp(16px, 2.5vw, 22px);
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: rgba(232, 232, 234, 0.9);
  }

  .card-icon {
    font-size: 20px;
    opacity: 0.85;
  }

  .card-title {
    font-weight: 700;
    font-size: clamp(16px, 2vw, 20px);
    color: #fff;
    margin: 0;
  }

  .card-copy {
    font-size: clamp(13px, 1.6vw, 15px);
    color: rgba(232, 232, 234, 0.78);
    line-height: 1.5;
    margin: 0;
  }

  @media (min-width: 980px) {
    .wb-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.2fr);
      align-items: start;
    }

    .wb-cards {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
